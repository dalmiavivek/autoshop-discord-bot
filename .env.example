# ==========================================
# Auto Buy & Stock Sync Discord Bot Configuration
# ==========================================

# 1. Discord Bot Credentials
# Get your bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Set your Discord Guild (Server) ID for instantaneous slash command sync during development.
# If left blank, commands will register globally (can take up to a few minutes).
GUILD_ID=

# 2. Permissions & Roles
# Admin IDs (comma-separated Discord User IDs who can run /addstock and admin commands)
ADMIN_USER_IDS=123456789012345678,987654321098765432

# Admin Role ID (members with this role can run /addstock)
ADMIN_ROLE_ID=

# Customer Role ID (automatically assigned when a customer verifies an order via /verify)
CUSTOMER_ROLE_ID=

# Optional: Channel ID where restock announcements will be posted when /addstock is used
RESTOCK_CHANNEL_ID=

# 3. Store Platform Selector
# Choose either 'shoppex' or 'sellauth'
STORE_PLATFORM=shoppex

# 4. Shoppex Configuration (if STORE_PLATFORM=shoppex)
# Obtain your API Key from: Shoppex Dashboard -> Settings -> Developer API
# Ensure it has 'products.read', 'products.write', and 'orders.read' scopes.
SHOPPEX_API_KEY=shoppex_api_key_here
SHOPPEX_STORE_DOMAIN=yourstore.shoppex.io

# 5. SellAuth Configuration (if STORE_PLATFORM=sellauth)
# Obtain your API Key and Shop ID from: SellAuth Dashboard -> Account -> Developers
SELLAUTH_API_KEY=sellauth_api_key_here
SELLAUTH_SHOP_ID=your_shop_id_here

# 6. DM Shop Crypto & Ticket System Configuration
# Category ID in your Discord server where private order tickets will be created
TICKET_CATEGORY_ID=

# Staff / Support Role ID that will have access to private order tickets
STAFF_ROLE_ID=

# Channel ID for internal audit logs of verified crypto payments and forward destinations
PAYOUT_LOG_CHANNEL_ID=

# Default Admin Receiving Crypto Addresses (or set them interactively using /setcrypto)
PAYOUT_LTC_ADDRESS=
PAYOUT_USDT_ADDRESS=
PAYOUT_BTC_ADDRESS=
PAYOUT_SOL_ADDRESS=

